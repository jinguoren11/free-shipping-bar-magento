<?xml version="1.0"?>
<!-- Download edition only: this file is removed from the Marketplace package. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="getdropflow_fsb_upgrade" xsi:type="object">GetDropFlow\FreeShippingBar\Console\Command\UpgradeCommand</item>
            </argument>
        </arguments>
    </type>
    <preference for="GetDropFlow\FreeShippingBar\Model\Authorization\Store" type="GetDropFlow\FreeShippingBar\Model\Authorization\FlagStore"/>
    <preference for="GetDropFlow\FreeShippingBar\Model\Authorization\Transport" type="GetDropFlow\FreeShippingBar\Model\Authorization\CurlTransport"/>
    <preference for="GetDropFlow\FreeShippingBar\Model\Authorization\Domain" type="GetDropFlow\FreeShippingBar\Model\Authorization\StoreDomain"/>
    <!-- The authorization rule. Without this file (Marketplace edition) the bar is not locked. -->
    <type name="GetDropFlow\FreeShippingBar\Model\Access">
        <arguments>
            <argument name="check" xsi:type="object">GetDropFlow\FreeShippingBar\Model\Authorization\AuthorizationGate</argument>
        </arguments>
    </type>
</config>
