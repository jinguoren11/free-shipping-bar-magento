<?php
/**
 * Copyright (c) GetDropFlow. Licensed under the MIT License.
 * Hyva (Alpine.js) version of the free shipping bar. CSP friendly: the logic lives in an external file and
 * the directives below only use property and method names.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \GetDropFlow\FreeShippingBarHyva\ViewModel\InitialState $initialState
 */
$initialState = $block->getData('initial_state');
$position = (string) $block->getData('position');
$kind = (string) ($block->getData('kind') ?: 'page');
?>
<?php
$cssUrl = $escaper->escapeUrl($block->getViewFileUrl('GetDropFlow_FreeShippingBar::css/bar.css'));
$jsUrl = $escaper->escapeUrl($block->getViewFileUrl('GetDropFlow_FreeShippingBarHyva::js/hyva-bar.js'));
?>
<link rel="stylesheet" href="<?= $cssUrl ?>">
<script src="<?= $jsUrl ?>"></script>
<div class="gdf-fsb-mount"
     data-gdf-mount="fsb_<?= $escaper->escapeHtmlAttr($position) ?>"
     data-position="<?= $escaper->escapeHtmlAttr($position) ?>"
     data-kind="<?= $escaper->escapeHtmlAttr($kind) ?>"
     data-initial="<?= $escaper->escapeHtmlAttr($initialState ? $initialState->getJson() : 'null') ?>"
     x-data="gdfFsb"
     @private-content-loaded.window="onPrivateContent">
    <template x-if="isVisible">
        <div class="gdf-fsb-bar" role="status" aria-live="polite" :class="barClass">
            <span class="gdf-fsb-message" x-text="message"></span>
            <template x-if="showTrack">
                <div class="gdf-fsb-track" role="progressbar"
                     aria-valuemin="0" aria-valuemax="100" :aria-valuenow="percent">
                    <div class="gdf-fsb-fill" :style="fillStyle"></div>
                </div>
            </template>
            <template x-if="showPercent">
                <span class="gdf-fsb-percent" x-text="percentText"></span>
            </template>
        </div>
    </template>
</div>
