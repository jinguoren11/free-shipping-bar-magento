<?xml version="1.0"?>
<!--
    Breeze (Swissup) only: this handle is applied only on stores that use the Breeze frontend, so Luma and Hyvä stores
    are not affected. Breeze replaces Luma's RequireJS/Knockout stack with its own scripts and needs (1) the component
    registered by name and (2) the mini cart region called "extraInfo" (Luma calls it "extra_info").
    The component file is the same one Luma uses.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="breeze.js">
            <arguments>
                <argument name="bundles" xsi:type="array">
                    <item name="default" xsi:type="array">
                        <item name="items" xsi:type="array">
                            <item name="GetDropFlow_FreeShippingBar/js/view/bar" xsi:type="array">
                                <item name="path" xsi:type="string">GetDropFlow_FreeShippingBar/js/view/bar</item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="minicart">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="minicart_content" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="extra_info" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="free_shipping_bar" xsi:type="array">
                                            <item name="componentDisabled" xsi:type="boolean">true</item>
                                        </item>
                                    </item>
                                </item>
                                <item name="extraInfo" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="free_shipping_bar" xsi:type="array">
                                            <item name="component" xsi:type="string">GetDropFlow_FreeShippingBar/js/view/bar</item>
                                            <item name="config" xsi:type="array">
                                                <item name="position" xsi:type="string">minicart</item>
                                                <item name="kind" xsi:type="string">region</item>
                                            </item>
                                            <item name="sortOrder" xsi:type="string">10</item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
